export const knowledge = {"company":{"name":"Steel Mind Engineers Pvt. Ltd.","tagline":"Where Steel Meets Intelligence","stats":[{"value":30,"suffix":"+","label":"projects completed"},{"value":8,"suffix":"+","label":"years of experience"},{"value":10,"suffix":"+","label":"cities served"},{"value":1000,"suffix":"+","label":"tons of steel fabricated","format":true}],"phones":["+92 300 4253966","+92 307 7077549"],"email":"info@steelmind.pk","headOffice":"35-D Commercial, DHA EME Sector, Lahore","factory":"Karol Ghati, Lahore, Punjab 54000"},"clients":["Haier","Imperial Denim","Moiz Steel","Saif Engineers","Dravton Dairy","Latifia Dairy","Maria B","Elite Stitching","MAB","Agha Waqar"],"projects":[{"title":"PEB Crane and Mezzanine Shed","client":"Haier","location":"Raiwind, Lahore","type":"PEB crane and mezzanine shed","height":"33 ft","width":"182 ft","length":"532 ft","area":"97,888 sq ft"},{"title":"PEB Dairy Shed","client":"Dravton Dairy","location":"Chunian","type":"PEB dairy shed","height":"17 ft","width":"115 ft","length":"342 ft","area":"39,330 sq ft"},{"title":"PEB Milking Parlour Shed","client":"Dravton Dairy","location":"Chunian","type":"PEB milking parlour shed","height":"17 ft","width":null,"length":null,"area":"21,686 sq ft"},{"title":"PEB Mezzanine Floor","client":"Maria B","location":"Lahore","type":"PEB mezzanine floor","height":"12 ft","width":"90 ft","length":"78 ft","area":"7,020 sq ft"},{"title":"Dairy Rapid Exit Structure","client":"Dravton Dairy","location":"Chunian","type":"Dairy rapid exit structure","height":"7 ft","width":"22 ft","length":"22 ft","area":"484 sq ft"},{"title":"Water Requirement Bridge","client":"M/S Yascon","location":"Petaro Cantt, Sindh","type":"Water requirement bridge","height":"30 ft","width":"6 ft","length":"150 ft","area":"900 sq ft"}],"pages":[{"title":"What Is a Pre-Engineered Building? A Plain Guide for Pakistani Business Owners","url":"/blog/what-is-a-pre-engineered-building/","answer":"A pre-engineered building, or PEB, is a steel building whose frames, purlins and sheets are designed in advance and made in a factory to exact sizes. The parts are then bolted together on your site. This is why a PEB is usually finished sooner than a concrete building of the same size."},{"title":"PEB vs Concrete Construction in Pakistan: Time, Cost and Flexibility Compared","url":"/blog/peb-vs-concrete-construction-pakistan/","answer":"For wide, open buildings such as factories, warehouses and farm sheds, a PEB is usually faster to build than a concrete building and easier to extend. Concrete is the better choice when the building needs heavy walls for fire or security. The right answer depends on your use, size and site."},{"title":"How Long Does It Take to Build a PEB in Pakistan? The Stages and the Schedule","url":"/blog/how-long-to-build-peb-pakistan/","answer":"PEB construction time in Pakistan depends on the size of the building, the speed of design approval, the foundation and the site. A PEB is usually ready sooner than a concrete building because fabrication and foundation work run at the same time. The engineer gives a written schedule with the quote."},{"title":"The Data an Engineer Needs Before Quoting Your Steel Building in Pakistan","url":"/blog/data-needed-to-quote-steel-building/","answer":"To quote a steel building, an engineer needs the use, width, length, eave height, roof slope, bay spacing, loads, site location, openings and any crane or mezzanine. A rough sketch with these numbers is enough to start, and the engineer will ask for the rest."},{"title":"How to Plan a Dairy Shed for Pakistan's Heat: Roof, Ridge and Airflow","url":"/blog/dairy-shed-design-pakistan-heat/","answer":"A good dairy shed in Pakistan gives shade, lets hot air leave and keeps the floor dry. Plan a high roof, an open ridge, open or louvered sides, an insulated roof where needed and a floor that drains. Steel Mind Engineers has built dairy sheds of 39,330, 22,000 and 21,686 square feet for Dravton Dairy and Latifia Dairy."},{"title":"Poultry Shed Roofs in Pakistan: Why Insulated Panels Help Your Birds and Your Costs","url":"/blog/poultry-shed-roof-insulated-panels/","answer":"An insulated poultry shed keeps the inside cooler in summer and warmer in winter, so the ventilation system has less work to do. Insulated roof panels, planned fan openings and a frame that carries hanging equipment are the three things to design first. Steel Mind Engineers designs long, narrow steel houses for this use."},{"title":"Factory Shed Checklist for Pakistan: Ten Questions to Answer Before You Build","url":"/blog/factory-shed-checklist-pakistan/","answer":"Before you order a steel factory shed, answer ten questions: what the plant does, which machines it holds, how wide and long it must be, how high, whether a crane is needed, what the floor must carry, how light and air will enter, where trucks will go, what services hang from the roof and how you will extend it later."},{"title":"Crane Shed Basics in Pakistan: Capacity, Span and Runway Beams Explained","url":"/blog/crane-shed-basics-pakistan/","answer":"A crane shed is a steel building designed around its overhead cranes. The crane capacity, span, lifting height and working frequency set the size of the columns, the runway beams and the foundation. Steel Mind Engineers built crane sheds of 96,600 and 97,888 square feet for Haier at Raiwind."},{"title":"How to Choose Warehouse Height for Your Racking in Pakistan","url":"/blog/warehouse-height-for-racking-pakistan/","answer":"Set the eave height of a warehouse from the top of your tallest rack, plus clearance for lights, sprinklers and handling equipment. Then check the clear span for aisles and the floor for point loads. Give the engineer your racking plan before the first drawing, because height is hard to change once the steel is made."},{"title":"Loading Dock Design in Pakistan: Dock Height, Canopy and Yard Depth","url":"/blog/loading-dock-design-pakistan/","answer":"A good loading dock lets a truck back in, load quickly and leave. Set the dock height from your truck fleet, add a steel canopy for rain and sun, choose the number of doors from the trucks you load at the same time, and leave enough yard depth for turning. Design the frame spacing to match the dock doors."},{"title":"Cold Storage Buildings in Pakistan: What the Steel Frame Must Do","url":"/blog/cold-storage-steel-frame-pakistan/","answer":"A cold store keeps goods at a set temperature, so the building must stop heat from entering. The steel frame carries the insulated roof and wall panels, the refrigeration equipment and the doors. Plan sealed joints, a tight envelope and the equipment loads from the first drawing, and coordinate with your cooling specialist."},{"title":"Storing Wheat in a Steel Warehouse in Pakistan: Keep It Dry and Ventilated","url":"/blog/wheat-storage-steel-warehouse-pakistan/","answer":"Wheat must stay dry and cool. A steel grain warehouse needs a leak-free roof, a sealed and raised floor, steady ventilation and walls designed for the sideways push of the stored grain. A good coating protects the steel from grain dust and moisture."},{"title":"Pre-Engineered Steel Buildings and Structural Fabrication, Built Across Pakistan","url":"/","answer":"Steel Mind Engineers is a Pakistani steel company that designs, fabricates and erects pre-engineered buildings, industrial sheds, steel warehouses and custom steel structures. One team handles each project from the first drawing to the final handover."},{"title":"About Steel Mind Engineers: A Steel Fabrication and Engineering Company in Pakistan","url":"/about-us/introduction/","answer":"Steel Mind Engineers Pvt. Ltd. designs, fabricates and erects steel structures in Pakistan. It has completed over thirty projects in more than ten cities and fabricated over a thousand tons of steel."},{"title":"Our Vision: A Trusted Steel Fabrication and Engineering Company for Pakistani Industry","url":"/about-us/vision/","answer":"The vision of Steel Mind Engineers is to be a trusted steel fabrication and engineering company and to build long-term partnerships with industry in Pakistan."},{"title":"Our Mission: Dependable Steel Fabrication With Quality, Safety and Efficiency","url":"/about-us/mission/","answer":"The mission of Steel Mind Engineers is to provide dependable fabrication and erection that meets each client's structural and operating needs, with quality, safety and efficiency."},{"title":"Our Core Values: Quality Fabrication, Continuous Improvement, and Safety and Reliability","url":"/about-us/core-values/","answer":"Steel Mind Engineers works by three values: quality fabrication, continuous improvement, and safety and reliability. Each value shows in the inspection steps, the reviews and the site rules that apply to every project."},{"title":"SME Policy: Quality, Health, Safety and Environment at Steel Mind Engineers","url":"/about-us/sme-policy/","answer":"The SME Policy of Steel Mind Engineers sets the rules for quality control, health and safety, and environmental care in the workshop and on site."},{"title":"Committed To: Accurate Steel, Safe Sites and Honest Schedules","url":"/about-us/committed-to/","answer":"Steel Mind Engineers makes five commitments on every project: steel that matches the drawing, a written schedule, safe work on site, one point of contact and support after handover."},{"title":"Factory Tour: Inside the Steel Mind Engineers Fabrication Factory in Lahore","url":"/about-us/factory-tour/","answer":"The Steel Mind Engineers factory is at Karol Ghati, Lahore. Steel moves through five stages: material yard, cutting, fitting and welding, cleaning and painting, and packing and dispatch."},{"title":"Pre-Engineered Buildings in Pakistan: Designed, Fabricated and Erected by One Team","url":"/pre-engineered-buildings-pakistan/","answer":"A pre-engineered building (PEB) is a steel building whose parts are designed in advance and made in a factory. Steel Mind Engineers designs, fabricates and erects PEBs in Pakistan under one contract."},{"title":"PEB Overview: What Is a Pre-Engineered Building?","url":"/pre-engineered-buildings-pakistan/overview/","answer":"A pre-engineered building is a steel building made from parts that are designed and cut in a factory and then bolted together on your site. This removes most of the guesswork and much of the time from site work."},{"title":"Advantages of Pre-Engineered Buildings for Pakistani Industry","url":"/pre-engineered-buildings-pakistan/advantages/","answer":"A PEB is built faster than a concrete building, uses steel more efficiently, spans wide areas without columns and can be extended later. It suits factories, warehouses and farms that need large, open space."},{"title":"3D Concept Design: See Your Pre-Engineered Building Before It Is Built","url":"/pre-engineered-buildings-pakistan/3d-concept/","answer":"A 3D concept is a three-dimensional model of your steel building that you review and approve before any steel is cut. It confirms height, layout, openings and clearances early, when changes cost very little."},{"title":"One-Step Solution: A Turnkey Steel Building From Design to Handover","url":"/pre-engineered-buildings-pakistan/one-step-solution/","answer":"The one-step solution means one company and one contract for the whole steel building: design, 3D approval, detailing, fabrication, painting, delivery, erection and support after handover."},{"title":"Engineering Department: PEB Design and Detailing in Pakistan","url":"/pre-engineered-buildings-pakistan/engineering-department/","answer":"The Steel Mind Engineers engineering department turns your requirement into a safe, buildable steel design, prepares the drawings used by the factory and the site crews, and checks each design before release."},{"title":"Primary Framing System: Columns and Rafters of a Pre-Engineered Building","url":"/pre-engineered-buildings-pakistan/primary-framing-system/","answer":"The primary frame is the steel skeleton of a PEB. It is made of columns and rafters that carry every load to the foundation. Steel Mind Engineers designs ten frame types, from clear-span to multi-span and roof systems."},{"title":"Basic Parameters: The Data Needed to Design Your Steel Building","url":"/pre-engineered-buildings-pakistan/basic-parameters/","answer":"To design a steel building, an engineer needs the width, length, eave height, roof slope, bay spacing, loads, site location, openings and any crane or mezzanine. A rough sketch with these numbers is enough to start."},{"title":"Sub Structures: Purlins, Girts, Bracing, Canopies and Roof Monitors in a PEB","url":"/pre-engineered-buildings-pakistan/sub-structures/","answer":"Sub structures are the parts attached to the main frame of a PEB. They include purlins, girts and bracing, which carry the sheets and keep the building stable, and add-on structures such as canopies, fascia, roof monitors, platforms and stairs."},{"title":"Crane System: Pre-Engineered Buildings Designed for Overhead Cranes","url":"/pre-engineered-buildings-pakistan/crane-system/","answer":"A PEB that carries an overhead crane needs stronger columns, accurate runway beams and extra bracing, all designed from the start. Steel Mind Engineers built crane sheds of 96,600 and 97,888 square feet for Haier at Raiwind."},{"title":"Mezzanine System: More Floor Area Inside Your Steel Building","url":"/pre-engineered-buildings-pakistan/mezzanine-system/","answer":"A mezzanine is an extra steel floor built inside a building. It adds usable area for offices, storage or production without enlarging the building footprint. Steel Mind Engineers built a 32,400 square foot mezzanine for Haier and a 7,020 square foot mezzanine for Maria B."},{"title":"Accessories for Pre-Engineered Buildings: Light, Air, Insulation, Doors and Safe Access","url":"/pre-engineered-buildings-pakistan/accessories/","answer":"PEB accessories control light, air, temperature, entry and safe access. They include skylights, ventilators, louvers, insulation, doors, ladders, stairs and walkways, and they are chosen by the use of the building."},{"title":"Industrial Sheds in Pakistan: Steel Sheds for Production, Farming and Heavy Work","url":"/industrial-sheds-pakistan/","answer":"An industrial shed is a large steel building that gives covered space for production, storage, animals or machines. Steel Mind Engineers designs the shed, makes the steel in Lahore and erects it on your site anywhere in Pakistan."},{"title":"Factory Sheds in Pakistan: Steel Buildings for Production Lines and Plants","url":"/industrial-sheds-pakistan/factory-sheds/","answer":"A factory shed is a steel building that holds your machines, people and material flow. Steel Mind Engineers designs it around your production layout with clear spans, the right height and good light and air."},{"title":"Dairy Farm Sheds in Pakistan: Steel Cattle Housing Built for Heat and Airflow","url":"/industrial-sheds-pakistan/dairy-farm-sheds/","answer":"A good dairy shed gives shade, lets hot air leave and keeps the floor dry. Steel Mind Engineers has built dairy sheds of 39,330, 22,000 and 21,686 square feet for Dravton Dairy and Latifia Dairy."},{"title":"Poultry Sheds in Pakistan: Steel Houses With Controlled Air and Temperature","url":"/industrial-sheds-pakistan/poultry-sheds/","answer":"A poultry shed must hold a stable temperature and give steady ventilation. Steel Mind Engineers designs long, narrow steel houses with insulated roofs and frames that carry hanging equipment."},{"title":"Workshop Sheds in Pakistan: Steel Buildings for Repair and Fabrication Work","url":"/industrial-sheds-pakistan/workshop-sheds/","answer":"A workshop shed holds vehicles, machines and tools. It needs strong frames, large doors, good light and good ventilation. Steel Mind Engineers designs it around the largest vehicle or machine that must enter."},{"title":"Crane Sheds in Pakistan: Steel Sheds Built for Heavy Overhead Cranes","url":"/industrial-sheds-pakistan/crane-sheds/","answer":"A crane shed is a steel building with overhead cranes on rails along its length. Steel Mind Engineers built a 96,600 square foot crane shed and a 97,888 square foot crane and mezzanine shed for Haier at Raiwind."},{"title":"Steel Warehouses in Pakistan: Wide-Span Storage and Logistics Buildings","url":"/steel-warehouses-pakistan/","answer":"A steel warehouse gives you open floor area for racks, pallets and trucks. Steel Mind Engineers designs it for your goods and handling method, makes the steel in Lahore and erects it on your site in Pakistan."},{"title":"Storage Warehouses in Pakistan: Steel Buildings for Stock and Raw Material","url":"/steel-warehouses-pakistan/storage-warehouses/","answer":"A storage warehouse protects goods from rain, sun and dust while keeping them easy to reach. The best steel design is simple: wide bays, a clean floor and doors in the right places."},{"title":"Logistics Warehouses in Pakistan: Steel Hubs for Fast Loading and Distribution","url":"/steel-warehouses-pakistan/logistics-warehouses/","answer":"A logistics warehouse works like a hub where goods arrive, are sorted and leave in a short time. The building needs wide aisles, many doors and enough yard space for trucks."},{"title":"Cold Storage Warehouses in Pakistan: Steel Frames for Insulated Stores","url":"/steel-warehouses-pakistan/cold-storage-warehouses/","answer":"A cold store keeps goods at a set temperature, so the building must stop heat from entering. Steel Mind Engineers supplies the steel frame and the supports for insulated roof and wall panels."},{"title":"Grain and Wheat Warehouses in Pakistan: Dry, Ventilated Steel Storage","url":"/steel-warehouses-pakistan/grain-and-wheat-warehouses/","answer":"Grain must stay dry and cool. A steel grain warehouse needs a tight roof, steady ventilation and walls strong enough to hold the sideways push of the grain."},{"title":"Warehouses With Loading Docks in Pakistan: Truck Access Built Into the Steel Frame","url":"/steel-warehouses-pakistan/warehouses-with-loading-docks/","answer":"A good loading dock lets a truck back in, load quickly and leave. Steel Mind Engineers designs the dock height, canopy, doors and frame spacing together so loading is fast, dry and safe."},{"title":"Structural Steel Fabrication in Pakistan: Columns, Beams, Trusses and Complete Frames","url":"/structural-steel-fabrication-pakistan/","answer":"Structural steel fabrication is the making of load-carrying steel parts from plates and sections. The parts are cut, drilled, welded and painted in a workshop, then bolted or welded together on site. Steel Mind Engineers fabricates to your drawings or to drawings prepared by its own engineers."},{"title":"Steel Columns and Beams Fabrication in Pakistan: The Main Frame of Your Building","url":"/structural-steel-fabrication-pakistan/columns-and-beams/","answer":"Columns carry loads down to the foundation, and beams carry loads across openings. Steel Mind Engineers fabricates both from rolled and built-up sections, cut and welded to drawing and checked before painting."},{"title":"Steel Roof Trusses in Pakistan: Light, Strong Members for Long Spans","url":"/structural-steel-fabrication-pakistan/trusses/","answer":"A truss is a frame of straight members arranged in triangles, so it spans long distances with little steel. Steel Mind Engineers fabricates pitched, parallel-chord and space trusses for roofs and sheds."},{"title":"Steel Mezzanine Floors in Pakistan: Fabricated and Erected to Your Load","url":"/structural-steel-fabrication-pakistan/mezzanine-floors/","answer":"A steel mezzanine floor adds usable area inside an existing or new building. Steel Mind Engineers designs, fabricates and erects the columns, beams, deck and stairs. It built a 32,400 square foot floor for Haier and a 7,020 square foot floor for Maria B."},{"title":"Steel Bridge Fabrication in Pakistan: Footbridges, Plant Bridges and Girder Spans","url":"/structural-steel-fabrication-pakistan/steel-bridges/","answer":"Steel bridges are light, strong and quick to install. Steel Mind Engineers fabricated and erected a 150-foot water requirement bridge for M/S Yascon at Petaro Cantt, Sindh."},{"title":"Crane Gantry Structures in Pakistan: Steel Supports for Outdoor and Yard Cranes","url":"/structural-steel-fabrication-pakistan/crane-gantry-structures/","answer":"A gantry is a steel structure that holds crane rails in an open yard with no building around it. Steel Mind Engineers fabricates the legs, runway beams, bracing and access for outdoor cranes."},{"title":"Custom Steel Fabrication in Pakistan: Steel Products Made to Your Drawing","url":"/custom-steel-fabrication-pakistan/","answer":"Custom steel fabrication means making a steel item to your own design and size. Steel Mind Engineers Pvt. Ltd. fabricates machine frames, tanks, hoppers, doors, gates and stairs from your drawing or sketch."},{"title":"Machine Frame Fabrication in Pakistan: Strong, Flat Supports for Your Equipment","url":"/custom-steel-fabrication-pakistan/machine-frames/","answer":"A machine frame holds equipment in the right position and carries its weight and vibration. Steel Mind Engineers fabricates machine frames to your drawing, with flat mounting surfaces and welds that are inspected before painting."},{"title":"Steel Storage Tank Fabrication in Pakistan: Welded Tanks Made to Your Size","url":"/custom-steel-fabrication-pakistan/storage-tanks/","answer":"A steel storage tank is a welded container for liquids or bulk goods. Steel Mind Engineers fabricates tanks to your size, with inspected welds, openings in the right places and a coating suited to the contents."},{"title":"Steel Hoppers and Bins in Pakistan: Fabricated for Smooth Bulk Material Flow","url":"/custom-steel-fabrication-pakistan/hoppers-and-bins/","answer":"A bin holds bulk material, and a hopper is a bin with a sloped bottom that guides the material to an outlet. Steel Mind Engineers fabricates hoppers and bins with the right slope, wall strength and support frame."},{"title":"Steel Doors and Gates in Pakistan: Strong Entrances for Factories, Farms and Warehouses","url":"/custom-steel-fabrication-pakistan/steel-doors-and-gates/","answer":"Steel Mind Engineers fabricates sliding gates, hinged gates, rolling doors and personnel doors to your opening size. They are built with strong frames, suitable hardware and a coating that resists rust."},{"title":"Steel Stairs Fabrication in Pakistan: Safe Access for Plants, Warehouses and Mezzanines","url":"/custom-steel-fabrication-pakistan/steel-stairs/","answer":"Steel Mind Engineers fabricates straight, switchback and spiral stairs, ladders, platforms and walkways. Each is designed for people and carried goods, with handrails, toe plates and non-slip treads."},{"title":"Steel Construction Services in Pakistan: From Design to After Sale Support","url":"/services/","answer":"Steel Mind Engineers Pvt. Ltd. provides seven services in one chain: design, detailing, fabrication, cleaning, painting, erection and after sale service. You can buy the whole chain or any single step."},{"title":"Steel Structure Design in Pakistan: Engineering for Safe, Efficient Buildings","url":"/services/design/","answer":"Design is the first service in a steel project. Steel Mind Engineers engineers set the loads, choose the frame and size every member, then show you a 3D model for approval before any steel is cut."},{"title":"Steel Detailing Services in Pakistan: Drawings That the Factory and the Site Can Use","url":"/services/detailing/","answer":"Detailing turns an approved design into drawings for every steel part. Steel Mind Engineers prepares fabrication drawings, cutting lists and erection drawings so that parts are made right and fit on site the first time."},{"title":"Steel Fabrication Services in Pakistan: Cutting, Welding and Assembly to Your Drawing","url":"/services/fabrication/","answer":"Fabrication is the stage where steel plates and sections become finished parts. Steel Mind Engineers Pvt. Ltd. cuts, drills, fits and welds each part in its own factory, inspects it and packs it in erection order."},{"title":"Steel Surface Cleaning in Pakistan: Preparing Steel for a Coating That Lasts","url":"/services/cleaning/","answer":"Cleaning is the step between fabrication and painting. Steel Mind Engineers removes mill scale, rust, oil, grease and weld spatter so that the coating bonds to bare steel and lasts longer."},{"title":"Steel Structure Painting in Pakistan: Coating Systems That Protect Steel for Years","url":"/services/painting/","answer":"Painting protects steel from rust. Steel Mind Engineers applies a primer and, where the project needs it, further coats chosen for the building's use and weather. Parts leave the factory with the agreed coating."},{"title":"Steel Erection Services in Pakistan: Safe Assembly of Your Steel Building on Site","url":"/services/erection/","answer":"Erection is the assembly of the fabricated steel on your site. Steel Mind Engineers crews work from the same drawings the factory used, follow a written lifting plan, bolt the structure to specification and fit the sheeting and accessories."},{"title":"After Sale Services in Pakistan: Repairs, Extensions and Support for Steel Buildings","url":"/services/after-sale-services/","answer":"A steel building needs care for decades. Steel Mind Engineers Pvt. Ltd. stays available after handover for repairs, repainting, added bays, new accessories and questions about the structure."},{"title":"Our Projects: Steel Buildings and Structures Built Across Pakistan","url":"/projects/","answer":"Steel Mind Engineers Pvt. Ltd. has built six documented projects with full details here, from a 484 square foot exit structure to a 97,888 square foot crane and mezzanine shed. Each card opens a page with size, client and location."},{"title":"PEB Store Shed for Haier at Raiwind: 32,400 Square Feet of Open Storage Space","url":"/projects/haier-peb-store-shed-raiwind/","answer":"Steel Mind Engineers Pvt. Ltd. designed, fabricated and erected a pre-engineered store shed for Haier at Raiwind, Lahore. The shed is 30 feet high, 180 feet wide and 180 feet long and covers 32,400 square feet."},{"title":"PEB Dairy Shed for Latifia Dairy at Kasur: 22,000 Square Feet of Steel Cattle Housing","url":"/projects/latifia-dairy-peb-dairy-shed-kasur/","answer":"Steel Mind Engineers Pvt. Ltd. built a pre-engineered dairy shed for Latifia Dairy at Kasur. The shed is 17 feet high, 110 feet wide and 200 feet long and covers 22,000 square feet."},{"title":"PEB Milking Parlour Shed for Dravton Dairy at Chunian: 21,686 Square Feet Under One Roof","url":"/projects/dravton-dairy-peb-milking-parlour-shed-chunian/","answer":"Steel Mind Engineers Pvt. Ltd. built a pre-engineered milking parlour shed for Dravton Dairy at Chunian. The shed is 17 feet high and covers 21,686 square feet."},{"title":"Steel Mezzanine Floor for Haier at Raiwind: 32,400 Square Feet of Added Floor Area","url":"/projects/haier-mezzanine-floor-raiwind/","answer":"Steel Mind Engineers Pvt. Ltd. fabricated and erected a steel mezzanine floor for Haier at Raiwind, Lahore. The floor is 12 feet high, 180 feet wide and 180 feet long and covers 32,400 square feet."},{"title":"Dairy Feed Storage Shed for Dravton Dairy at Chunian: 8,000 Square Feet of Dry Storage","url":"/projects/dravton-dairy-feed-storage-shed-chunian/","answer":"Steel Mind Engineers Pvt. Ltd. built a pre-engineered feed storage shed for Dravton Dairy at Chunian. The shed is 17 feet high, 80 feet wide and 100 feet long and covers 8,000 square feet."},{"title":"PEB Dairy Shed for Dravton Dairy at Chunian: 39,330 Square Feet of Steel Cattle Housing","url":"/projects/dravton-dairy-peb-dairy-shed-chunian/","answer":"Steel Mind Engineers Pvt. Ltd. built a pre-engineered dairy shed for Dravton Dairy at Chunian. The shed is 17 feet high, 115 feet wide and 342 feet long and covers 39,330 square feet. It is the largest dairy shed Steel Mind Engineers has built."},{"title":"PEB Crane Shed for Haier at Raiwind: 96,600 Square Feet Built for Overhead Cranes","url":"/projects/haier-peb-crane-shed-raiwind/","answer":"Steel Mind Engineers Pvt. Ltd. designed, fabricated and erected a pre-engineered crane shed for Haier at Raiwind, Lahore. The shed is 30 feet high, 184 feet wide and 525 feet long and covers 96,600 square feet."},{"title":"PEB Mezzanine Floor for Maria B in Lahore: 7,020 Square Feet of Added Floor Area","url":"/projects/maria-b-peb-mezzanine-floor-lahore/","answer":"Steel Mind Engineers Pvt. Ltd. built a pre-engineered mezzanine floor for Maria B in Lahore. The floor is 12 feet high, 90 feet wide and 78 feet long and covers 7,020 square feet."},{"title":"Steel Water Requirement Bridge for M/S Yascon at Petaro Cantt, Sindh: 150 Feet Long","url":"/projects/yascon-water-requirement-bridge-petaro/","answer":"Steel Mind Engineers Pvt. Ltd. fabricated and erected a steel water requirement bridge for M/S Yascon at Petaro Cantt, Sindh. The bridge is 150 feet long, 6 feet wide and 30 feet high, with an area of 900 square feet."},{"title":"Dairy Rapid Exit Structure for Dravton Dairy at Chunian: 484 Square Feet of Custom Steel","url":"/projects/dravton-dairy-rapid-exit-structure-chunian/","answer":"Steel Mind Engineers Pvt. Ltd. built a dairy rapid exit structure for Dravton Dairy at Chunian. The structure is 7 feet high, 22 feet wide and 22 feet long and covers 484 square feet."},{"title":"PEB Crane and Mezzanine Shed for Haier at Raiwind: 97,888 Square Feet Under One Roof","url":"/projects/haier-peb-crane-and-mezzanine-shed-raiwind/","answer":"Steel Mind Engineers Pvt. Ltd. built a pre-engineered crane and mezzanine shed for Haier at Raiwind, Lahore. The shed is 33 feet high, 182 feet wide and 532 feet long and covers 97,888 square feet. It is the largest project Steel Mind Engineers has built."},{"title":"Our Clients: Companies That Have Built With Steel Mind Engineers in Pakistan","url":"/clients/","answer":"Steel Mind Engineers Pvt. Ltd. has worked for ten clients in manufacturing, dairy, apparel, steel and infrastructure, including Haier, Dravton Dairy, Latifia Dairy and Maria B. Several clients came back for more than one structure."},{"title":"Company Profile: Steel Mind Engineers Pvt. Ltd.","url":"/company-profile/","answer":"The company profile is a 29-page PDF that introduces Steel Mind Engineers Pvt. Ltd., its services, its projects and its clients. Steel Mind Engineers designs, fabricates and erects steel structures in Pakistan."},{"title":"Steel Mind Engineers Blog: Plain Guides to Steel Buildings, Sheds and Fabrication in Pakistan","url":"/blog/","answer":"The Steel Mind Engineers blog answers the questions buyers ask before they build in steel: what a PEB is, how long it takes, how to plan a shed or warehouse, and how to compare quotes. Each article is short, plain and written by the engineers."},{"title":"Contact Steel Mind Engineers: Request a Quote for Your Steel Building","url":"/contact-us/","answer":"Call +92 300 4253966 or +92 307 7077549, email info@steelmind.pk, or send the quote form. An engineer reads each request and replies with questions and the next steps."}],"faq":[{"q":"Is a PEB the same as a prefabricated building?","a":"A PEB is a type of prefabricated steel building. Its main feature is that the frames are designed for the exact loads of your project and made in a factory."},{"q":"Can a PEB be extended later?","a":"Yes. Bolted frames allow extra bays at the end of the building, which is why dairy and logistics clients often add space later."},{"q":"How long does a PEB last?","a":"With a correct coating and regular care, a steel building serves for decades."},{"q":"Is a PEB cheaper than concrete?","a":"For wide, open buildings a PEB is usually faster and often lower in total cost. The saving depends on size, location and design."},{"q":"Is a steel building safe in heavy rain and wind?","a":"Each PEB is designed for the wind and rain loads of its site, so share the location with the engineer."},{"q":"Can I mix steel and concrete?","a":"Yes. Many buildings use a concrete foundation or walls with a steel frame and roof."},{"q":"Can the foundation start before the steel is ready?","a":"Yes. Once the anchor bolt plan is issued, the foundation can start while the factory works."},{"q":"Does monsoon rain stop a PEB project?","a":"Factory work continues under cover. Site work, such as the foundation and erection, may pause during heavy rain."},{"q":"Will I receive a written schedule?","a":"Yes. The schedule shows design approval, fabrication, delivery and erection before work starts."},{"q":"What is eave height?","a":"It is the height from the floor to the point where the roof meets the side wall."},{"q":"Do I need drawings to ask for a quote?","a":"No. A sketch with the main sizes and the use of the building is enough."},{"q":"Can I change the size after I receive the quote?","a":"Yes. The engineer will update the price to match the new size."},{"q":"How many animals can a shed hold?","a":"It depends on the area per animal and the layout. The engineer plans the width and length from your herd size."},{"q":"Is a steel roof too hot for cattle?","a":"A bare steel roof can be hot, so insulated sheets, a high roof and an open ridge are used to lower the heat."},{"q":"Can the shed be extended?","a":"Yes. Bolted frames allow extra bays at the end."},{"q":"What roof is best for poultry sheds?","a":"Insulated roof panels are best, because they keep the inside cooler and reduce the load on fans."},{"q":"Can the frame carry fans and feeding lines?","a":"Yes. Tell the engineer about the equipment so the frame is designed for its weight."},{"q":"Can I add a second house later?","a":"Yes. Plan the site layout early, and bolted frames make a new house easy to add."},{"q":"What size factory shed can Steel Mind Engineers build?","a":"Steel Mind Engineers has built sheds from a few thousand square feet to almost 100,000 square feet."},{"q":"Can the shed be built while the old one runs?","a":"Often yes. The engineer plans access and safe working zones with you."},{"q":"What should I send for a quote?","a":"Send the machine list, the floor plan, the site details and your future plans."},{"q":"Can I add a crane to a shed later?","a":"Only if the shed was designed for it. Say so at the quote stage, even if the crane will arrive in a later year."},{"q":"What details does the engineer need?","a":"The crane capacity, span, lifting height, number of cranes and working frequency."},{"q":"Can a shed carry two cranes?","a":"Yes, if the design includes both from the start."},{"q":"How tall can a warehouse be?","a":"The engineer sets the height from your racking and handling plan."},{"q":"Can I raise the height later?","a":"It is very hard. Settle the height before steel is made."},{"q":"Can Steel Mind Engineers build on a small plot?","a":"Yes. The frame can fit the plot shape, and a mezzanine can add floor area."},{"q":"Can docks be added to an existing warehouse?","a":"Often yes, after the engineer checks the wall and the floor."},{"q":"What door types suit a dock?","a":"Sectional roll-up doors suit most docks. See the Accessories page."},{"q":"How many dock doors can I have?","a":"As many as the layout and the yard allow."},{"q":"Can the steel frame carry refrigeration units?","a":"Yes. The engineer designs the frame for these loads."},{"q":"What temperature range can the store hold?","a":"That depends on the panels and the cooling system. Tell the engineer your target temperature."},{"q":"Does Steel Mind Engineers install the refrigeration plant?","a":"No. The cooling specialist you choose installs it, and Steel Mind Engineers coordinates the loads and openings."},{"q":"How do you keep grain dry in a steel store?","a":"Through a tight roof, a sealed floor and steady ventilation."},{"q":"Do you make bins and hoppers?","a":"Yes. See the Hoppers and Bins page."},{"q":"Can the store be extended before the next season?","a":"Yes. Bolted frames allow extra bays, and steel is quick to build."},{"q":"What is a pre-engineered building?","a":"A pre-engineered building is a steel structure whose frames, purlins and sheeting are designed in advance and made in a factory to exact dimensions. Site work is then mostly assembly. Because fabrication and foundation work run at the same time, the building is finished much sooner than a concrete building of the same size."},{"q":"Which cities in Pakistan does Steel Mind Engineers serve?","a":"Steel Mind Engineers has served more than ten cities. The factory is in Lahore, and erection crews travel to the project site, whether it is an industrial estate, a farm or an urban plot."},{"q":"What does Steel Mind Engineers build?","a":"Steel Mind Engineers builds pre-engineered buildings, structural steel frames, industrial sheds, steel warehouses, mezzanine floors, crane buildings, steel bridges and custom steel items."},{"q":"How do I request a quote?","a":"Send the intended use, approximate size and location through the quote form, or call +92 300 4253966. An engineer will review the requirement and reply with a proposal."},{"q":"Where is the Steel Mind Engineers factory?","a":"The factory is at Karol Ghati, Lahore, Punjab 54000."},{"q":"Can I visit before I sign a contract?","a":"Yes. Call to book a visit and an engineer will take you through the factory."},{"q":"Does Steel Mind Engineers fabricate outside Lahore?","a":"The fabrication is done in Lahore. The steel is then delivered and erected at project sites across Pakistan."},{"q":"What is the difference between a PEB and a normal steel building?","a":"A PEB is designed as a complete system. Each frame is sized for the exact loads of your building, so the steel is used where it is needed and not where it is not."},{"q":"How big can a PEB be?","a":"Clear-span frames can cover wide spans without inner columns. Steel Mind Engineers has built a PEB shed of 97,888 square feet."},{"q":"Can a PEB be extended later?","a":"Yes. A PEB is bolted together, so bays can be added at the end of the building."},{"q":"Is a PEB strong enough for Pakistani weather?","a":"Each PEB is designed for the wind, rain and load needs of its location. Share your site location so the engineer can set the design loads."},{"q":"How long does a PEB last?","a":"With a correct coating and regular maintenance, a steel building serves for decades."},{"q":"Is a PEB cheaper than concrete?","a":"For wide, open buildings a PEB is usually faster and often lower in total cost. The exact saving depends on size, location and design."},{"q":"Can a PEB have an insulated roof?","a":"Yes. Insulated sheets and panels can be added. See the Accessories page."},{"q":"Can I change the design after seeing the model?","a":"Yes. Changes are easy before fabrication starts."},{"q":"Does the 3D model show the crane and the mezzanine?","a":"Yes, when your building has them, they appear in the model with their positions and clearances."},{"q":"Who is my contact during the project?","a":"A project coordinator is your single point of contact from contract to handover."},{"q":"Can I buy only fabrication?","a":"Yes. Steel Mind Engineers also supplies fabricated steel to your drawings. See Custom Steel Fabrication."},{"q":"Who checks the design?","a":"A second engineer checks each design before drawings are released to the factory."},{"q":"Do I need my own structural engineer?","a":"You may use your own consultant. Steel Mind Engineers coordinates with consultants and works to their approved requirements."},{"q":"What is a clear-span building?","a":"It is a building with no columns inside the width. The rafters span from wall to wall."},{"q":"Why are the columns tapered?","a":"The depth follows the bending forces. This uses less steel than a uniform section."},{"q":"What is eave height?","a":"It is the height from the floor to the point where the roof meets the side wall."},{"q":"Can I change the size after the quote?","a":"Yes. The price will change with the size, and the engineer will update the quote."},{"q":"What is the difference between a purlin and a girt?","a":"A purlin is on the roof. A girt is on the wall."},{"q":"Do I need insulated sheeting?","a":"It is useful for cold storage, poultry sheds and any building where machines or people need a lower temperature inside."},{"q":"Can I add a crane later?","a":"Only if the building was designed for it. Say so at the quote stage, even if the crane will come in a later year."},{"q":"What details does the engineer need for a crane building?","a":"The crane capacity, span, lifting height, number of cranes and working frequency."},{"q":"Can a mezzanine be added to an existing building?","a":"Often yes, after an engineer checks the building structure and the floor."},{"q":"How high should the ceiling be?","a":"The engineer will check that both the lower and the upper floor have enough clear height for people and goods."},{"q":"Do skylights make the building hot?","a":"Quality translucent sheets give light with less heat. The engineer will advise on the right quantity."},{"q":"Can accessories be added after handover?","a":"Yes. Many can be fitted later if the frame is ready for them."},{"q":"How long does it take to build a shed?","a":"It depends on the size and the foundation. The factory and the foundation work run at the same time, so the shed is ready sooner than a concrete one. The engineer will give a schedule with the quote."},{"q":"Can a shed have closed walls?","a":"Yes. Sheds can be fully sheeted, partly open or open on all sides."},{"q":"What size factory shed can Steel Mind Engineers build?","a":"Steel Mind Engineers has built sheds from a few thousand square feet to almost 100,000 square feet."},{"q":"Can the shed be built while the old one runs?","a":"Often yes. The engineer will plan access and safe working zones with you."},{"q":"How many animals can a shed hold?","a":"It depends on the area per animal and the layout. The engineer will plan the width and length from your herd size."},{"q":"Can the shed be extended?","a":"Yes. Bolted frames allow extra bays at the end."},{"q":"What roof is best for poultry sheds?","a":"Insulated roof panels are best because they keep the inside cooler."},{"q":"Can the frame carry fans and feeding lines?","a":"Yes. Tell the engineer about the equipment so the frame is designed for its weight."},{"q":"Can a workshop shed include a small office?","a":"Yes. A mezzanine or a side room can be added."},{"q":"Can the shed carry a hoist?","a":"Yes, if the hoist beam is included in the design."},{"q":"How big was the Raiwind crane shed?","a":"The crane shed covers 96,600 square feet, and the crane and mezzanine shed covers 97,888 square feet."},{"q":"Can the shed carry two cranes?","a":"Yes, if the design includes both from the start."},{"q":"How tall can a warehouse be?","a":"The engineer sets the height from your racking and handling plan."},{"q":"Can Steel Mind Engineers build a warehouse on a small plot?","a":"Yes. The frame can fit the plot shape, and a mezzanine can add floor area."},{"q":"Can the warehouse be moved?","a":"Bolted steel buildings can be taken down and reused, but this needs careful planning."},{"q":"What floor load can the warehouse carry?","a":"The floor is designed for the weights you give. Tell the engineer the racking and pallet weights."},{"q":"Can the warehouse carry solar panels?","a":"Yes, if the roof is designed for them from the start."},{"q":"How many dock doors can I have?","a":"As many as the layout and the yard allow."},{"q":"Can the steel frame carry refrigeration units?","a":"Yes. The engineer designs the frame for these loads."},{"q":"What temperature range can the store hold?","a":"That depends on the panels and the cooling system. Tell the engineer your target temperature."},{"q":"How do you keep grain dry?","a":"Through a tight roof, a sealed floor and steady ventilation."},{"q":"Do you make bins and hoppers?","a":"Yes. See the Hoppers and Bins page."},{"q":"Can docks be added to an existing warehouse?","a":"Often yes, after the engineer checks the wall and the floor."},{"q":"What door types suit a dock?","a":"Sectional roll-up doors suit most docks. See the Accessories page."},{"q":"Can Steel Mind Engineers fabricate from my drawings?","a":"Yes. Send the drawings and the engineer will review them and quote."},{"q":"Does Steel Mind Engineers erect the steel as well?","a":"Yes. Its own crews erect the structure on site."},{"q":"What is a built-up section?","a":"It is an I-shaped member made by welding two flanges to a web plate, so the depth and thickness can change along the member."},{"q":"Do the parts arrive painted?","a":"Yes. Parts leave the factory with a primer coat or the coating system chosen for the project."},{"q":"Is a truss cheaper than a solid beam?","a":"For long spans, often yes. A truss uses less steel for the same span."},{"q":"How long can a truss be?","a":"It depends on the load and the depth. The engineer will advise."},{"q":"How long does a mezzanine take to build?","a":"It depends on the area. The engineer will give a schedule with the quote."},{"q":"Can the floor be removed later?","a":"Yes. Bolted steel mezzanines can be taken apart."},{"q":"Can a steel bridge be moved?","a":"Bolted bridges can be taken apart and moved, if planned that way."},{"q":"How long does a steel bridge last?","a":"With good coating and maintenance, many decades."},{"q":"Can the gantry be extended?","a":"Yes, if the foundation and rails allow."},{"q":"What does the engineer need to design a gantry?","a":"The crane capacity, span, lifting height and travel length."},{"q":"What do I need to send for a quote?","a":"Send a drawing or a sketch with dimensions, the quantity and the place of use. Photos help but a drawing is better."},{"q":"Can Steel Mind Engineers copy an existing part?","a":"Yes. If you supply the part or a drawing, an engineer will measure it and prepare a drawing for your approval."},{"q":"Can Steel Mind Engineers fabricate a frame from a photo?","a":"An engineer needs measurements. A photo helps, but a drawing or a sample part is better."},{"q":"Does the frame arrive painted?","a":"Yes. Frames leave the factory with the coating chosen for the working environment."},{"q":"What details are needed to quote a tank?","a":"Send the capacity, the contents, the working temperature, the site and any connections you need."},{"q":"Can the tank be delivered in parts?","a":"Large tanks can be made in sections, transported and joined on site."},{"q":"What does the engineer need to design a hopper?","a":"The material type, its weight per cubic meter, the capacity and the outlet height you need."},{"q":"Can Steel Mind Engineers install the bin?","a":"Yes. Steel Mind Engineers can erect the bin and its support frame on your site."},{"q":"Can Steel Mind Engineers make doors for an existing building?","a":"Yes. An engineer will measure the opening on site."},{"q":"Which door suits a loading dock?","a":"A rolling or sectional door usually suits a dock best."},{"q":"Can stairs be added later?","a":"Yes, if the floor or platform can take the fixing loads."},{"q":"Can stairs be made for outdoor use?","a":"Yes. Outdoor stairs get a stronger coating against weather."},{"q":"Can I hire Steel Mind Engineers for erection only?","a":"Yes, after the engineer reviews the drawings and the site."},{"q":"Which service comes first?","a":"Design comes first. Detailing follows once you approve the design."},{"q":"Can Steel Mind Engineers work with my consultant?","a":"Yes. Steel Mind Engineers coordinates with your consultant and works to the approved requirements."},{"q":"How long does design take?","a":"It depends on the size and complexity. The engineer gives a date with the quote."},{"q":"What is the difference between design and detailing?","a":"Design sizes the structure. Detailing draws every part so it can be made and assembled."},{"q":"Do I approve the detail drawings?","a":"Yes. Drawings are approved before steel is cut."},{"q":"Can Steel Mind Engineers fabricate from my drawings?","a":"Yes. Send the drawings. An engineer reviews them and replies with questions and a quote."},{"q":"How are parts packed?","a":"Parts are marked and packed in erection order, so site crews find each part quickly."},{"q":"Why is cleaning needed if the steel is new?","a":"New steel carries mill scale and light rust. Paint on top of them peels early."},{"q":"Is cleaning done again on site?","a":"Only where parts are damaged or welded on site. Those areas are cleaned before touch-up."},{"q":"How long does a coating last?","a":"It depends on the system, the weather and the care the building receives. The engineer will explain the options with the quote."},{"q":"Can I choose the color?","a":"Yes. Tell the engineer at the design stage."},{"q":"Can Steel Mind Engineers erect steel it did not fabricate?","a":"Yes, after the engineer reviews the drawings and the site."},{"q":"What do I provide for erection?","a":"A clear site, truck access and a foundation that matches the anchor bolt plan."},{"q":"Can Steel Mind Engineers repair a building another company built?","a":"Often yes, after an engineer inspects it."},{"q":"Can I add a bay later?","a":"Yes. Bolted PEB frames allow extra bays at the end of the building."},{"q":"What is the largest project Steel Mind Engineers has built?","a":"The PEB crane and mezzanine shed for Haier at Raiwind covers 97,888 square feet."},{"q":"Can I visit a finished project?","a":"Call to ask. Visits depend on the client's permission."},{"q":"How big is the Haier store shed?","a":"It covers 32,400 square feet and stands 30 feet high."},{"q":"Can a store shed like this be extended?","a":"Yes. Bolted PEB frames allow extra bays."},{"q":"How big is the Latifia Dairy shed?","a":"It covers 22,000 square feet, with a width of 110 feet and a length of 200 feet."},{"q":"Can the shed be extended as the herd grows?","a":"Yes. Bolted frames allow extra bays at the end."},{"q":"What is a milking parlour shed?","a":"It is the covered building where cows are milked. It needs shade, clear floor space and steady airflow."},{"q":"Has Steel Mind Engineers built other structures for Dravton Dairy?","a":"Yes. It also built a dairy shed, a feed storage shed and a rapid exit structure at Chunian."},{"q":"How big is the Haier mezzanine floor?","a":"It covers 32,400 square feet and stands 12 feet high."},{"q":"Can a mezzanine be built inside an existing building?","a":"Often yes, after an engineer checks the building."},{"q":"How big is the feed storage shed?","a":"It covers 8,000 square feet, with a width of 80 feet and a length of 100 feet."},{"q":"How do you keep feed dry in a steel shed?","a":"Through a tight roof, good sheet laps and steady ventilation."},{"q":"How big is the Dravton Dairy shed?","a":"It covers 39,330 square feet, with a width of 115 feet and a length of 342 feet."},{"q":"Why use steel for dairy sheds?","a":"Steel goes up quickly, spans wide areas and allows extra bays when the herd grows."},{"q":"How big is the Haier crane shed?","a":"It covers 96,600 square feet, with a width of 184 feet and a length of 525 feet."},{"q":"Can a PEB carry overhead cranes?","a":"Yes, if the building is designed for them from the start."},{"q":"How big is the Maria B mezzanine?","a":"It covers 7,020 square feet and stands 12 feet high."},{"q":"Can a mezzanine be used for display or offices?","a":"Yes. The engineer sets the floor load from the use."},{"q":"How long is the Yascon bridge?","a":"It is 150 feet long, 6 feet wide and 30 feet high."},{"q":"Does Steel Mind Engineers work outside Punjab?","a":"Yes. It has completed projects in Sindh and in more than ten cities."},{"q":"Does Steel Mind Engineers take small jobs?","a":"Yes. Small custom structures are welcome, and they get the same checks as large buildings."},{"q":"Can Steel Mind Engineers build to my farm layout?","a":"Yes. Send the layout or a sketch with dimensions."},{"q":"How big is the crane and mezzanine shed?","a":"It covers 97,888 square feet, with a width of 182 feet and a length of 532 feet."},{"q":"Can one building have both cranes and a mezzanine?","a":"Yes, if the design includes both from the start."},{"q":"Who are the clients of Steel Mind Engineers?","a":"They include Haier, Dravton Dairy, Latifia Dairy, Maria B, Imperial Denim, Moiz Steel, Saif Engineers, Elite Stitching, MAB and Agha Waqar."},{"q":"Which sectors does Steel Mind Engineers serve?","a":"Manufacturing, dairy and livestock, apparel and retail, steel and engineering, and infrastructure."},{"q":"Who writes the Steel Mind Engineers blog?","a":"The articles are written from the experience of the Steel Mind Engineers engineers and project team."},{"q":"Can I ask for an article on a topic?","a":"Yes. Send your question from the Contact Us page."},{"q":"How fast does Steel Mind Engineers reply?","a":"An engineer reads each request and replies with questions and the next steps. Call if the matter is urgent."},{"q":"Does Steel Mind Engineers work outside Lahore?","a":"Yes. The factory is in Lahore, and crews erect the steel on sites across Pakistan."},{"q":"Can I send drawings?","a":"Yes. Use the upload field on the form or email the files."}]}
