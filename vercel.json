{
  "redirects": [
    { "source": "/about-us/introduction/", "destination": "/about-us/", "permanent": true },
    { "source": "/about-us/vision/", "destination": "/about-us/", "permanent": true },
    { "source": "/about-us/mission/", "destination": "/about-us/", "permanent": true },
    { "source": "/about-us/core-values/", "destination": "/about-us/", "permanent": true },
    { "source": "/about-us/sme-policy/", "destination": "/about-us/", "permanent": true },
    { "source": "/about-us/committed-to/", "destination": "/about-us/", "permanent": true },
    { "source": "/about-us/factory-tour/", "destination": "/about-us/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "functions": {
    "api/*.ts": { "memory": 512, "maxDuration": 15 }
  }
}
