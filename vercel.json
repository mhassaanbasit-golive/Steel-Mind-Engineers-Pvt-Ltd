{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/chat.ts": {
      "includeFiles": "api/_knowledge.json"
    }
  },
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!api/|chatbot/|assets/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
