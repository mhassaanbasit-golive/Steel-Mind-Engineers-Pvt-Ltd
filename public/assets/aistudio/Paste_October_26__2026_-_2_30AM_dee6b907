      ? body.messages
      : Array.isArray(body?.conversation)
      ? body.conversation
      : [];

    const messages = rawMessages.map((m: any) => ({
      role: m?.role || "user",
      text: typeof m?.text === "string" ? m.text : (typeof m?.content === "string" ? m.content : ""),
    }));

    const rating = body?.rating || "";
